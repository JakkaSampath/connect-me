# Test environment variables (copy to .env.test and fill in real values).
# Used only by `npm test`. Must point at a separate database from .env.

# Isolated test database. Same Postgres server as dev, different database name.
# Created and reset automatically on every test run.
DATABASE_URL=postgresql://carpool:carpool@localhost:5433/carpool_test?schema=public

# Any long random string; tests sign their own tokens with it.
JWT_SECRET=replace-with-a-long-random-test-secret

NODE_ENV=test
